# ElevenLabs text-to-speech (server-side — not exposed to the browser)
ELEVENLABS_API_KEY=

# Optional ElevenLabs model override (default: eleven_turbo_v2_5)
# ELEVENLABS_MODEL=eleven_turbo_v2_5

# Optional LLM for dynamic commentary before TTS (OpenAI-compatible API)
# VITE_LLM_API_KEY=
# VITE_LLM_API_URL=https://api.openai.com/v1/chat/completions
# VITE_LLM_MODEL=gpt-4o-mini

# Local: after creating .env, restart the dev server: npm run dev
# Production (Vercel): Project Settings → Environment Variables →
#   add ELEVENLABS_API_KEY for Production, then Redeploy.
# Partner Voice should show "ElevenLabs" (not "Not configured") once the key is live.
