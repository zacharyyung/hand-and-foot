# ElevenLabs text-to-speech (server-side — not exposed to the browser)
ELEVENLABS_API_KEY=

# Production (Vercel): add the same variable in Project Settings → Environment Variables,
# then redeploy. Phone/production uses /api/narration-tts on the server, not .env on your laptop.

# Optional ElevenLabs model override (default: eleven_turbo_v2_5)
# ELEVENLABS_MODEL=eleven_turbo_v2_5

# Optional LLM for dynamic commentary before TTS (OpenAI-compatible API)
# VITE_LLM_API_KEY=
# VITE_LLM_API_URL=https://api.openai.com/v1/chat/completions
# VITE_LLM_MODEL=gpt-4o-mini

# After creating .env, restart the dev server: npm run dev
# In Settings, the provider label should show "ElevenLabs" after Preview narrator voice.
